{
  "name": "inboxtasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InboxTasks — single-user PWA that turns email into reviewable to-do items.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:packages && npm-run-all --parallel dev:api dev:worker dev:web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:worker": "npm run dev --workspace apps/worker",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm-run-all build:shared build:db build:llm build:pipeline build:api build:worker build:web",
    "build:shared": "npm run build --workspace packages/shared",
    "build:db": "npm run build --workspace packages/db",
    "build:llm": "npm run build --workspace packages/llm",
    "build:pipeline": "npm run build --workspace packages/pipeline",
    "build:packages": "npm-run-all build:shared build:db build:llm build:pipeline",
    "build:api": "npm run build --workspace apps/api",
    "build:worker": "npm run build --workspace apps/worker",
    "build:web": "npm run build --workspace apps/web",
    "typecheck": "npm-run-all --parallel -c typecheck:shared typecheck:db typecheck:llm typecheck:pipeline typecheck:api typecheck:worker typecheck:web",
    "typecheck:shared": "npm run typecheck --workspace packages/shared",
    "typecheck:db": "npm run typecheck --workspace packages/db",
    "typecheck:llm": "npm run typecheck --workspace packages/llm",
    "typecheck:pipeline": "npm run typecheck --workspace packages/pipeline",
    "typecheck:api": "npm run typecheck --workspace apps/api",
    "typecheck:worker": "npm run typecheck --workspace apps/worker",
    "typecheck:web": "npm run typecheck --workspace apps/web",
    "test:shared": "npm run test --workspace packages/shared --if-present",
    "test:db": "npm run test --workspace packages/db --if-present",
    "test:llm": "npm run test --workspace packages/llm --if-present",
    "test:pipeline": "npm run test --workspace packages/pipeline --if-present",
    "test:all": "npm-run-all -c test:shared test:db test:llm test:pipeline",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema db/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema db/schema.prisma",
    "db:studio": "prisma studio --schema db/schema.prisma",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@inboxtasks/api": "*",
    "@inboxtasks/pipeline": "*",
    "@playwright/test": "1.49.0",
    "@types/node": "22.9.0",
    "npm-run-all": "4.1.5",
    "prisma": "5.22.0",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
