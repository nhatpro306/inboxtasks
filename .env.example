# --- Database ---
DATABASE_URL="postgresql://inboxtasks:inboxtasks@localhost:5432/inboxtasks?schema=public"
USER_EMAIL=supermanzero30@gmail.com

# --- Security ---
# 32-byte key, base64 or hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=

# --- AI ---
OLLAMA_URL=http://localhost:11434
AI_PROVIDER_PREF=auto
GEMINI_API_KEY=

# --- Web Push (VAPID) ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:supermanzero30@gmail.com

# --- Worker ---
POLL_INTERVAL_MINUTES=60

# --- API ---
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback
# --- Vercel (serverless, Gemini-only) ---
# Set AI_PROVIDER_PREF=gemini and supply a real Gemini API key (no Ollama in the cloud).
# AI_PROVIDER_PREF=gemini
# GEMINI_API_KEY=<your-gemini-api-key>
#
# Use a POOLED Postgres URL (e.g. Neon pgbouncer or Supabase pooler) for serverless connection limits.
# DATABASE_URL=postgresql://<user>:<pass>@<pooler-host>/<db>?pgbouncer=true&connection_limit=1
#
# Set these to your deployed Vercel domain:
# GOOGLE_REDIRECT_URI=https://<your-domain>/api/calendar/callback
# WEB_ORIGIN=https://<your-domain>
#
# Optional: protect the /api/cron endpoint with a secret header (add to Vercel Cron config if used).
# CRON_SECRET=

# --- Web build-time (Vite) ---
# Leave empty on Vercel for same-origin API calls (/api/...). Set for a separate API domain.
VITE_API_URL=
