{
  "name": "@inboxtasks/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@inboxtasks/db": "*",
    "@inboxtasks/llm": "*",
    "@inboxtasks/pipeline": "*",
    "@inboxtasks/shared": "*",
    "dotenv": "16.4.5",
    "fastify": "5.8.5",
    "googleapis": "144.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
